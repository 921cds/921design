# Only api.php is reachable from the web; config, backups and login records stay private.
<FilesMatch "^(?!api\.php$).*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
